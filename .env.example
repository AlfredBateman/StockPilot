# Copy this file to .env and fill in real values. Never commit .env.

# When true, the server runs without any live/paid data sources.
DEMO_MODE=true

# Which LLM provider turns free-text requests into a FilterSpec (or a short
# educational answer). Every failure here falls back to the rule-based parser,
# so the app never depends on this at runtime. LLM_PROVIDER is "nvidia",
# "gemini" or "groq"; the model name is only ever read from LLM_MODEL, never
# guessed. Leave any of these blank to skip the cloud tier entirely (no
# network call is made).
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Most cloud LLM calls allowed per UTC day, across all users (default 300).
# Past it, the search box uses keyword matching only until the next day.
LLM_DAILY_CAP=

# Optional local fallback, tried after the cloud tier. Ollama's API requires a
# model name, so leaving this blank skips the Ollama tier without calling it.
# Assumes Ollama's default http://localhost:11434.
OLLAMA_MODEL=

# Port the Express server listens on (the web dev proxy targets this).
PORT=3001

# MongoDB Atlas connection string for the stock data source. Leave blank to
# read data/stocks.json instead. Never commit a real value.
MONGODB_URI=
