{
  "name": "stockpilot-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "snapshot": "tsx scripts/snapshot.ts",
    "ingest": "tsx scripts/ingest.ts",
    "seed": "tsx scripts/seed.ts",
    "mongo:status": "tsx scripts/mongoStatus.ts",
    "eval": "tsx ../eval/run.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.2",
    "express": "^5.2.1",
    "mongodb": "^7.7.0",
    "yahoo-finance2": "^4.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
